# Turso database URL — use https:// prefix (not libsql://) for serverless
TURSO_DATABASE_URL=https://your-database-name.turso.io

# Turso auth token
TURSO_AUTH_TOKEN=your-auth-token-here

# Password to log in to the app
APP_PASSWORD=your-chosen-password

# Receipt photos (optional) - a Cloudflare R2 bucket and an API token with
# Object Read & Write on it. See README.md for the bucket's CORS policy.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=your-receipts-bucket
